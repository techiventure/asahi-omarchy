# Omarchy Asahi pacman configuration
# Packages sourced from:
#   - Arch Linux ARM official mirrors (core, extra, alarm, aur)
#   - Omarchy Asahi repo (self-built Apple Silicon packages on R2 CDN)

[options]
Color
ILoveCandy
VerbosePkgLists
HoldPkg = pacman glibc
Architecture = auto
CheckSpace
ParallelDownloads = 5
DownloadUser = alpm

SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional

# Arch Linux ARM official repos
[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist

[alarm]
Include = /etc/pacman.d/mirrorlist

[aur]
Include = /etc/pacman.d/mirrorlist

# Omarchy Asahi packages (built from AsahiLinux/* source, hosted on R2)
[omarchy-asahi]
SigLevel = Optional TrustAll
Include = /etc/pacman.d/mirrorlist.omarchy-asahi
